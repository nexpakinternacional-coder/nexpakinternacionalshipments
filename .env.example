# URL del proyecto en Supabase — se encuentra en: Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=

# Clave pública (anon) de Supabase — se encuentra en: Supabase → Settings → API → anon key
# Esta clave es pública: puede ir en el frontend. Nunca uses la service_role aquí.
VITE_SUPABASE_ANON_KEY=

# URL pública del sitio — sin barra al final (ej. https://nexpak.com)
# Se usa en: og:image, og:url, QR del rótulo PDF y enlace de compartir en rastreo.
# Dejar vacío en desarrollo (el sitio usa window.location.origin como respaldo).
VITE_PUBLIC_URL=
